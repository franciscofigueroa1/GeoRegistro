<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_mapa"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEstadoMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/mapa_cargando"
            android:accessibilityLiveRegion="polite" />

        <Button
            android:id="@+id/btnActualizarMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_actualizar_mapa" />

        <FrameLayout
            android:id="@+id/contenedorMapa"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnVolverMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_volver" />

    </LinearLayout>
</LinearLayout>
